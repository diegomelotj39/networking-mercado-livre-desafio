# Configuração Palo Alto para tunnel VPN com framework IPSec 

# Configuração do IKE Gateway (Phase 1)
set network ike gateway FGT-PA-GW address 201.201.201.1
set network ike gateway FGT-PA-GW authentication pre-shared-key "P@ssw0rd"
set network ike gateway FGT-PA-GW protocol ikev1 proposal aes-256-sha256
set network ike gateway FGT-PA-GW protocol ikev1 dh-group group14

# Configuração do IPSec Tunnel (Phase 2)
set network tunnel ipsec FGT-PA-TUNNEL auto-key ike-gateway FGT-PA-GW
set network tunnel ipsec FGT-PA-TUNNEL auto-key ipsec-crypto-profile AES256-SHA256
set network tunnel ipsec FGT-PA-TUNNEL tunnel-interface tunnel.1

# Interface de túnel
set network interface tunnel.1 ip 169.255.1.2/30
set network interface tunnel.1 mtu 1427

# Seletores de tráfego
set network tunnel ipsec FGT-PA-TUNNEL auto-key proxy-id LOCAL-FGT remote 10.10.10.0/24
set network tunnel ipsec FGT-PA-TUNNEL auto-key proxy-id REMOTE-PA remote 10.20.20.0/24

# Regras de segurança
set rulebase security rules VPN-FGT-PA from trust to untrust source 10.10.10.0/24 destination 10.20.20.0/24 application any action allow

# Ao automatizar a configuração entre dispositivos de diferentes fabricantes, ficar atento para esses desafios:

Incompatibilidade de protocolos: fabricantes podem utilizar padrões de configuração diferentes.
Interoperabilidade: garantir que equipamentos distintos consigam trocar informações corretamente, consultando datasheet.
Autenticação e segurança: credenciais devem corresponder (neste caso PSK) e os protocolos de criptografia, DH e Profile IPSec devem corresponder.
Diferenças de comandos: atentar para os padrões de sintaxe diferentes para cada fabricante.